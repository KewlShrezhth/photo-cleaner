{
  "expo": {
    "name": "Photo Cleaner",
    "slug": "photo-cleaner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.photocleaner.app"
    },
    "android": {
      "package": "com.photocleaner.app",
      "adaptiveIcon": {
        "backgroundColor": "#6750A4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      ["expo-location", { "locationWhenInUsePermission": "Photo Cleaner uses your location access only to turn photo locations into place names." }],
      [
        "expo-media-library",
        {
          "photosPermission": "Photo Cleaner reads your photos so it can find the best ones.",
          "savePhotosPermission": "Photo Cleaner needs access to move the photos you choose into an Archive album.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#6750A4",
          "dark": { "image": "./assets/splash-icon.png", "backgroundColor": "#381E72" }
        }
      ]
    ]
  }
}
